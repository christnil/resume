{
  "name": "resume",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://christnil.github.io/resume",
  "type": "module",
  "dependencies": {
    "gh-pages": "^6.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.1"
  },
  "scripts": {
    "generatepdf": "node create-tex.mjs && mkdir -p dist && pdflatex -output-directory dist christoffer-nilsson-en.tex",
    "generatepdf:spotify": "node create-tex-spotify.mjs",
    "predeploy": "npm run build && npm run generatepdf",
    "deploy": "gh-pages -d dist",
    "start": "vite",
    "build": "vite build"
  }
}
